    "# Cell 2: 라이브러리 import 및 설정\n",
    "import sys\n",
    "import tempfile\n",
    "import subprocess\n",
    "import os\n",
    "import json\n",
    "import re\n",
    "import inspect\n",
    "from urllib.parse import quote\n",
    "\n",
    "# 노트북에서 시각 디버깅을 원하면 False로 설정하세요\n",
