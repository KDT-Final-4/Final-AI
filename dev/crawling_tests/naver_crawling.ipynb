    "\n",
    "# 검색할 키워드 입력 (여기를 수정하세요)\n",
    "SEARCH_KEYWORD = \"패딩\"  # 예시: \"노트북\", \"스마트폰\", \"명품가방\" 등\n",
    "\n",
    "# 최대 수집할 상품 개수\n",
